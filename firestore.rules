rules_version = '2';

// ============================================================================
// REGRAS DO FIRESTORE - Quadro de Fluxo (projeto de teste "kanbanvr")
// ----------------------------------------------------------------------------
// COMO USAR ESTE ARQUIVO
//
// Ele ja contem as regras DEFINITIVAS, mas comeca em MODO ABERTO para voce
// conseguir configurar tudo (cadastrar o administrador e os departamentos).
//
//   >>> PARA FECHAR, troque UMA linha:   modoAberto() -> return false;
//
// Nao e preciso apagar nem reescrever nada: as regras reais ja estao aqui
// embaixo, so ficam adormecidas enquanto o modo aberto estiver ligado.
//
// ATENCAO: com modoAberto() em true, qualquer pessoa com as credenciais do
// projeto le e escreve tudo, inclusive sem estar logada. Use apenas durante a
// configuracao inicial, com dados de teste.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- INTERRUPTOR GERAL ----------------
    // true  = libera tudo (configuracao inicial)
    // false = valem as regras reais definidas abaixo
    function modoAberto() {
      return false;          // <<<<<< TROQUE PARA false QUANDO TERMINAR
    }

    // ---------------- Auxiliares ----------------

    // Dono do quadro: acesso total, sempre, independente de cadastro.
    // E a garantia de nunca ficar trancado do lado de fora.
    function souDono() {
      return request.auth != null
        && request.auth.token.email.lower() == 'marcos.centrone@vrbelohorizonte.com.br';
    }

    function logado() {
      return request.auth != null;
    }

    // So e-mails @vrbelohorizonte.com.br (verificados) contam como "da empresa".
    // E a mesma trava 1 do portal, agora no SERVIDOR. Antes vivia so no cliente
    // (DOMINIOS_PERMITIDOS, em firebase-config.js), entao qualquer conta Google
    // passava se chamasse a API direto. Aqui nao passa mais.
    function doDominio() {
      return logado()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@vrbelohorizonte[.]com[.]br');
    }

    function meuEmail() {
      return request.auth.token.email.lower();
    }

    function souAdmin() {
      return souDono()
        || (logado()
            && exists(/databases/$(database)/documents/kanban_acessos/$(meuEmail()))
            && get(/databases/$(database)/documents/kanban_acessos/$(meuEmail())).data.admin == true);
    }

    // ---- Visibilidade por departamento (mesma logica do carregarPermissao) ----

    function temCadastro() {
      return exists(/databases/$(database)/documents/kanban_acessos/$(meuEmail()));
    }

    // Departamentos que a pessoa acompanha. So chamar depois de confirmar que
    // temCadastro() e true, senao o get() falha.
    function meusDeps() {
      return get(/databases/$(database)/documents/kanban_acessos/$(meuEmail())).data.departamentos;
    }

    // Ve o quadro inteiro: admin, OU nao cadastrado, OU cadastrado sem nenhum
    // departamento marcado (igual ao "veTudo" do cliente).
    function veTudoCards() {
      return souAdmin() || !temCadastro() || meusDeps().size() == 0;
    }

    // Supervisor: faz tudo no(s) departamento(s) que acompanha - tanto as
    // tarefas quanto as listas/subtarefas-padrao do departamento. NAO ve outros
    // departamentos nem gerencia acessos (isso continua so com administrador).
    function ehSupervisor() {
      return temCadastro()
        && get(/databases/$(database)/documents/kanban_acessos/$(meuEmail())).data.supervisor == true;
    }

    function supervisionaDepto(dep) {
      return ehSupervisor() && dep in meusDeps();
    }

    // ---------------- Tarefas ----------------
    match /kanban_cards/{cardId} {

      // Dono da tarefa: o e-mail que criou (criadoPor).
      function donoDaTarefa() {
        return resource.data.criadoPor == meuEmail();
      }

      // Responsavel: gravado por e-mail (responsavelEmail) alem do nome, justo
      // para o servidor conseguir comparar - aqui so existe o e-mail do token.
      function responsavelDaTarefa() {
        return 'responsavelEmail' in resource.data
          && resource.data.responsavelEmail == meuEmail();
      }

      // Sem dono real: criadoPor ausente ou que nao e um e-mail (cards antigos,
      // criados antes do login). Esses qualquer um do dominio pode mexer.
      function semDonoReal() {
        return !('criadoPor' in resource.data)
          || !(resource.data.criadoPor is string)
          || !resource.data.criadoPor.matches('.*@.*');
      }

      // A MESMA regra do podeAlterar() da interface, agora no servidor.
      // O supervisor do departamento da tarefa tambem pode mexer em qualquer
      // tarefa daquele departamento.
      function podeMexer() {
        return souAdmin() || donoDaTarefa() || responsavelDaTarefa() || semDonoReal()
          || supervisionaDepto(resource.data.departamento);
      }

      // Validacao de tamanho/tipo dos campos, para barrar documentos gigantes
      // (abuso de custo) e lixo. request.resource.data e o doc apos a escrita,
      // entao vale para create e update. Campos opcionais so sao checados se
      // presentes, para nao travar updates parciais (mover, mudar etapa...).
      function cardValido() {
        let d = request.resource.data;
        return d.titulo is string && d.titulo.size() >= 1 && d.titulo.size() <= 200
          && (!('descricao' in d) || (d.descricao is string && d.descricao.size() <= 2000))
          && (!('departamento' in d) || (d.departamento is string && d.departamento.size() <= 60))
          && (!('responsavel' in d) || (d.responsavel is string && d.responsavel.size() <= 60))
          && (!('coluna' in d) || (d.coluna is string && d.coluna.size() <= 60))
          && (!('subtarefas' in d) || (d.subtarefas is list && d.subtarefas.size() <= 6))
          && (!('prioridade' in d) || d.prioridade in ['baixa', 'media', 'alta']);
      }

      // Ler: so quem ve o departamento da tarefa (admin/veTudo veem todos).
      allow read: if modoAberto() || souDono()
        || (doDominio() && (veTudoCards() || resource.data.departamento in meusDeps()));

      // Criar: pessoa do dominio, respeitando o schema.
      allow create: if modoAberto() || souDono() || (doDominio() && cardValido());

      // Alterar e excluir: dono, responsavel, admin - ou tarefa sem dono.
      // Alterar tambem valida o schema; excluir nao tem corpo para validar.
      allow update: if modoAberto() || souDono() || (doDominio() && podeMexer() && cardValido());
      allow delete: if modoAberto() || souDono() || (doDominio() && podeMexer());
    }

    // ---------------- Departamentos ----------------
    // Todos os logados leem (o quadro precisa da lista). Criar, excluir e
    // renomear um departamento continua so com administrador. O SUPERVISOR do
    // departamento pode editar apenas as listas e as subtarefas-padrao dele.
    match /kanban_departamentos/{departamentoId} {
      function supervisionaEste() {
        return ehSupervisor() && resource.data.nome in meusDeps();
      }
      // So deixa mexer em colunas/subtarefasPadrao (e no carimbo atualizadoEm) -
      // nunca no nome ou em outros campos.
      function soListasESubs() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['colunas', 'subtarefasPadrao', 'atualizadoEm']);
      }
      function listasSubsValidas() {
        let d = request.resource.data;
        return (!('colunas' in d) || (d.colunas is list && d.colunas.size() <= 6))
          && (!('subtarefasPadrao' in d) || (d.subtarefasPadrao is list && d.subtarefasPadrao.size() <= 6));
      }

      allow read:   if modoAberto() || souDono() || doDominio();
      allow create: if modoAberto() || souAdmin();
      allow delete: if modoAberto() || souAdmin();
      allow update: if modoAberto() || souAdmin()
        || (doDominio() && supervisionaEste() && soListasESubs() && listasSubsValidas());
    }

    // ---------------- Acessos (e-mail -> departamentos) ----------------
    // Leitura liberada a quem e do dominio da empresa: auth.js precisa ler o
    // proprio documento e a tela administrativa precisa saber se ja existe um
    // admin. (Ainda expoe a tabela inteira a qualquer funcionario - apertar
    // para "so o proprio doc + admin" e um proximo passo.)
    // Escrita so para administradores.
    match /kanban_acessos/{email} {
      allow read:  if modoAberto() || souDono() || doDominio();
      allow write: if modoAberto() || souAdmin();
    }

    // ---------------- Auditoria ----------------
    // Trilha de alteracoes: quem mudou o que, e quando.
    //
    // Escrita: qualquer pessoa logada CRIA registros (e o proprio app que grava
    // ao salvar uma tarefa). Mas ninguem edita nem apaga um registro - nem
    // administrador. Uma trilha que pode ser reescrita nao serve como trilha.
    //
    // Leitura: administrador (e quem ve tudo) enxerga a trilha inteira; os
    // demais so os registros dos departamentos que acompanham - a MESMA regra
    // de isolamento das tarefas. A consulta do cliente precisa filtrar por
    // departamento (where departamento in ...), senao o Firestore recusa.
    match /kanban_auditoria/{registroId} {
      allow read:   if modoAberto() || souDono()
        || (doDominio() && (veTudoCards() || resource.data.departamento in meusDeps()));

      // create exige que o campo porEmail seja o PROPRIO e-mail de quem grava.
      // Sem isso, qualquer logado forjava registros em nome de outra pessoa -
      // uma trilha com autoria falsificavel nao serve como trilha.
      allow create: if modoAberto() || (
        doDominio()
        && request.resource.data.porEmail == request.auth.token.email.lower()
      );

      allow update, delete: if false;
    }

    // Qualquer outra colecao continua bloqueada.
  }
}
