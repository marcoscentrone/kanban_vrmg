rules_version = '2';

// ============================================================================
// REGRAS DO FIRESTORE - Quadro de Fluxo (projeto "kanbanvr")
// ----------------------------------------------------------------------------
// Acesso por PAPEL e DEPARTAMENTO, sempre exigindo login do dominio da empresa.
// Nao existe mais "modo aberto": toda leitura/escrita passa pelas regras abaixo.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- Auxiliares ----------------

    // Dono do quadro: acesso total, sempre, independente de cadastro.
    // E a garantia de nunca ficar trancado do lado de fora.
    function souDono() {
      return request.auth != null
        && request.auth.token.email.lower() == 'marcos.centrone@vrbelohorizonte.com.br';
    }

    function logado() {
      return request.auth != null;
    }

    // So e-mails @vrbelohorizonte.com.br (verificados) contam como "da empresa".
    // E a mesma trava 1 do portal, agora no SERVIDOR. Antes vivia so no cliente
    // (DOMINIOS_PERMITIDOS, em firebase-config.js), entao qualquer conta Google
    // passava se chamasse a API direto. Aqui nao passa mais.
    function doDominio() {
      return logado()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@vrbelohorizonte[.]com[.]br');
    }

    function meuEmail() {
      return request.auth.token.email.lower();
    }

    function souAdmin() {
      return souDono()
        || (logado()
            && exists(/databases/$(database)/documents/kanban_acessos/$(meuEmail()))
            && get(/databases/$(database)/documents/kanban_acessos/$(meuEmail())).data.admin == true);
    }

    // ---- Visibilidade por departamento (mesma logica do carregarPermissao) ----

    function temCadastro() {
      return exists(/databases/$(database)/documents/kanban_acessos/$(meuEmail()));
    }

    // Departamentos que a pessoa acompanha. So chamar depois de confirmar que
    // temCadastro() e true, senao o get() falha.
    function meusDeps() {
      return get(/databases/$(database)/documents/kanban_acessos/$(meuEmail())).data.departamentos;
    }

    // Ve o quadro inteiro: admin, OU nao cadastrado, OU cadastrado sem nenhum
    // departamento marcado (igual ao "veTudo" do cliente).
    function veTudoCards() {
      return souAdmin() || !temCadastro() || meusDeps().size() == 0;
    }

    // Supervisor: faz tudo no(s) departamento(s) que acompanha - tanto as
    // tarefas quanto as listas/subtarefas-padrao do departamento. NAO ve outros
    // departamentos nem gerencia acessos (isso continua so com administrador).
    function ehSupervisor() {
      return temCadastro()
        && get(/databases/$(database)/documents/kanban_acessos/$(meuEmail())).data.supervisor == true;
    }

    function supervisionaDepto(dep) {
      return ehSupervisor() && dep in meusDeps();
    }

    // Quem pode arquivar uma tarefa (finalizar/cancelar), olhando os dados do
    // doc arquivado. Espelha o podeMexer(): admin, dono, responsavel, supervisor
    // do departamento, ou tarefa sem dono real.
    function podeArquivar(d) {
      return souAdmin()
        || (d.criadoPor == meuEmail())
        || ('responsavelEmail' in d && d.responsavelEmail == meuEmail())
        || supervisionaDepto(d.departamento)
        || !('criadoPor' in d) || !(d.criadoPor is string) || !d.criadoPor.matches('.*@.*');
    }

    // Leitura de um arquivo (finalizados/cancelados): mesma visibilidade das
    // tarefas - admin/ve-tudo tudo, supervisor o departamento dele, usuario
    // comum so onde ele e o responsavel.
    function podeLerArquivo() {
      return souDono() || (doDominio() && (
        veTudoCards()
        || supervisionaDepto(resource.data.departamento)
        || (resource.data.departamento in meusDeps()
            && 'responsavelEmail' in resource.data
            && resource.data.responsavelEmail == meuEmail())
      ));
    }

    // ---------------- Tarefas ----------------
    match /kanban_cards/{cardId} {

      // Dono da tarefa: o e-mail que criou (criadoPor).
      function donoDaTarefa() {
        return resource.data.criadoPor == meuEmail();
      }

      // Responsavel: gravado por e-mail (responsavelEmail) alem do nome, justo
      // para o servidor conseguir comparar - aqui so existe o e-mail do token.
      function responsavelDaTarefa() {
        return 'responsavelEmail' in resource.data
          && resource.data.responsavelEmail == meuEmail();
      }

      // Sem dono real: criadoPor ausente ou que nao e um e-mail (cards antigos,
      // criados antes do login). Esses qualquer um do dominio pode mexer.
      function semDonoReal() {
        return !('criadoPor' in resource.data)
          || !(resource.data.criadoPor is string)
          || !resource.data.criadoPor.matches('.*@.*');
      }

      // A MESMA regra do podeAlterar() da interface, agora no servidor.
      // O supervisor do departamento da tarefa tambem pode mexer em qualquer
      // tarefa daquele departamento.
      function podeMexer() {
        return souAdmin() || donoDaTarefa() || responsavelDaTarefa() || semDonoReal()
          || supervisionaDepto(resource.data.departamento);
      }

      // Tarefa sem responsavel definido.
      function semResponsavel() {
        return !('responsavelEmail' in resource.data)
          || resource.data.responsavelEmail == '';
      }

      // Usuario comum "pega" para si uma tarefa SEM responsavel do departamento
      // dele - so pode se colocar (nunca outra pessoa).
      function pegarParaMim() {
        return temCadastro()
          && resource.data.departamento in meusDeps()
          && semResponsavel()
          && request.resource.data.responsavelEmail == meuEmail();
      }

      // Quem pode colocar OUTRA pessoa como responsavel: so admin e o supervisor
      // do departamento. Os demais so deixam sem responsavel, se colocam, ou
      // mantem o responsavel que ja estava.
      function naoAtribuiAOutro() {
        let novo = ('responsavelEmail' in request.resource.data)
          ? request.resource.data.responsavelEmail : '';
        let antigo = (resource != null && 'responsavelEmail' in resource.data)
          ? resource.data.responsavelEmail : '';
        return novo == antigo
          || novo == ''
          || novo == meuEmail()
          || souAdmin()
          || supervisionaDepto(request.resource.data.departamento);
      }

      // Validacao de tamanho/tipo dos campos, para barrar documentos gigantes
      // (abuso de custo) e lixo. request.resource.data e o doc apos a escrita,
      // entao vale para create e update. Campos opcionais so sao checados se
      // presentes, para nao travar updates parciais (mover, mudar etapa...).
      function cardValido() {
        let d = request.resource.data;
        return d.titulo is string && d.titulo.size() >= 1 && d.titulo.size() <= 200
          && (!('descricao' in d) || (d.descricao is string && d.descricao.size() <= 2000))
          && (!('departamento' in d) || (d.departamento is string && d.departamento.size() <= 60))
          && (!('responsavel' in d) || (d.responsavel is string && d.responsavel.size() <= 60))
          && (!('coluna' in d) || (d.coluna is string && d.coluna.size() <= 60))
          && (!('subtarefas' in d) || (d.subtarefas is list && d.subtarefas.size() <= 6))
          && (!('prioridade' in d) || d.prioridade in ['baixa', 'media', 'alta']);
      }

      // Ler:
      //   . admin / quem ve tudo  -> qualquer tarefa
      //   . supervisor            -> qualquer tarefa do(s) departamento(s) dele
      //   . usuario comum         -> SO as tarefas em que ele e o responsavel,
      //                              dentro do departamento dele (nao ve tarefas
      //                              de outras pessoas do grupo).
      // A consulta do cliente precisa refletir isso: o usuario comum consulta
      // por departamento E responsavelEmail == o proprio e-mail.
      // Usuario comum ve, alem das proprias, as tarefas SEM responsavel do
      // departamento dele (o "pool" que qualquer um pode pegar).
      allow read: if souDono()
        || (doDominio() && (
              veTudoCards()
              || supervisionaDepto(resource.data.departamento)
              || (resource.data.departamento in meusDeps()
                  && (responsavelDaTarefa() || semResponsavel()))
           ));

      // Criar: pessoa do dominio, respeitando o schema. Usuario comum nao pode
      // ja criar atribuindo a OUTRA pessoa (so a si mesmo ou sem responsavel).
      allow create: if souDono()
        || (doDominio() && cardValido() && naoAtribuiAOutro());

      // Alterar: quem pode mexer (dono/responsavel/admin/supervisor/sem-dono) OU
      // o usuario comum pegando para si uma tarefa sem responsavel. Em todos os
      // casos, so admin/supervisor podem apontar OUTRA pessoa como responsavel.
      allow update: if souDono()
        || (doDominio() && cardValido() && naoAtribuiAOutro()
            && (podeMexer() || pegarParaMim()));
      allow delete: if souDono() || (doDominio() && podeMexer());
    }

    // ---------------- Departamentos ----------------
    // Todos os logados leem (o quadro precisa da lista). Criar, excluir e
    // renomear um departamento continua so com administrador. O SUPERVISOR do
    // departamento pode editar apenas as listas e as subtarefas-padrao dele.
    match /kanban_departamentos/{departamentoId} {
      function supervisionaEste() {
        return ehSupervisor() && resource.data.nome in meusDeps();
      }
      // So deixa mexer em colunas/subtarefasPadrao (e no carimbo atualizadoEm) -
      // nunca no nome ou em outros campos.
      function soListasESubs() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['colunas', 'subtarefasPadrao', 'atualizadoEm']);
      }
      function listasSubsValidas() {
        let d = request.resource.data;
        return (!('colunas' in d) || (d.colunas is list && d.colunas.size() <= 6))
          && (!('subtarefasPadrao' in d) || (d.subtarefasPadrao is list && d.subtarefasPadrao.size() <= 6));
      }

      allow read:   if souDono() || doDominio();
      allow create: if souAdmin();
      allow delete: if souAdmin();
      allow update: if souAdmin()
        || (doDominio() && supervisionaEste() && soListasESubs() && listasSubsValidas());
    }

    // ---------------- Acessos (e-mail -> departamentos) ----------------
    // Leitura liberada a quem e do dominio da empresa: auth.js precisa ler o
    // proprio documento e a tela administrativa precisa saber se ja existe um
    // admin. (Ainda expoe a tabela inteira a qualquer funcionario - apertar
    // para "so o proprio doc + admin" e um proximo passo.)
    // Escrita so para administradores.
    match /kanban_acessos/{email} {

      // Doc que um SUPERVISOR pode gerenciar: membro comum (nunca admin nem
      // supervisor) cujos departamentos estao TODOS dentro dos que ele
      // supervisiona. Assim o supervisor nunca nomeia admin nem mexe em gente
      // de outro departamento.
      function docSupervisionavel(d) {
        return ehSupervisor()
          && d.admin != true
          && d.supervisor != true
          && d.departamentos is list
          && d.departamentos.size() > 0
          && meusDeps().hasAll(d.departamentos);
      }

      // Ler: so o proprio documento, admin e supervisor. Isso evita que um
      // funcionario comum liste todos os e-mails e quem e admin/supervisor.
      // (Usuario comum nao precisa ler a tabela - ele nao atribui responsaveis.)
      allow read:  if souDono()
        || (doDominio() && (souAdmin() || ehSupervisor() || email == meuEmail()));

      // Criar: admin (qualquer); supervisor (dentro do escopo dele); ou a
      // PROPRIA pessoa no primeiro acesso, escolhendo departamentos - nunca
      // como admin nem supervisor.
      allow create: if souAdmin()
        || (doDominio() && docSupervisionavel(request.resource.data))
        || (doDominio() && email == meuEmail()
            && request.resource.data.admin != true
            && request.resource.data.supervisor != true
            && request.resource.data.departamentos is list
            && request.resource.data.departamentos.size() <= 30);

      // Alterar: admin; ou supervisor quando o doc ANTES e DEPOIS continua no
      // escopo dele (nao pode promover a admin/supervisor nem jogar para fora).
      allow update: if souAdmin()
        || (doDominio() && docSupervisionavel(resource.data)
            && docSupervisionavel(request.resource.data));

      // Excluir: admin; ou supervisor para um membro do escopo dele.
      allow delete: if souAdmin()
        || (doDominio() && docSupervisionavel(resource.data));
    }

    // ---------------- Auditoria ----------------
    // Trilha de alteracoes: quem mudou o que, e quando.
    //
    // Escrita: qualquer pessoa logada CRIA registros (e o proprio app que grava
    // ao salvar uma tarefa). Mas ninguem edita nem apaga um registro - nem
    // administrador. Uma trilha que pode ser reescrita nao serve como trilha.
    //
    // Leitura: administrador (e quem ve tudo) enxerga a trilha inteira; os
    // demais so os registros dos departamentos que acompanham - a MESMA regra
    // de isolamento das tarefas. A consulta do cliente precisa filtrar por
    // departamento (where departamento in ...), senao o Firestore recusa.
    match /kanban_auditoria/{registroId} {
      // Tamanho dos campos, para um registro nao virar vetor de abuso de custo.
      function auditoriaValida() {
        let d = request.resource.data;
        return (!('tarefaId' in d) || (d.tarefaId is string && d.tarefaId.size() <= 200))
          && (!('tarefaTitulo' in d) || (d.tarefaTitulo is string && d.tarefaTitulo.size() <= 200))
          && (!('departamento' in d) || (d.departamento is string && d.departamento.size() <= 60))
          && (!('responsavelEmail' in d) || (d.responsavelEmail is string && d.responsavelEmail.size() <= 120))
          && (!('acao' in d) || (d.acao is string && d.acao.size() <= 40))
          && (!('alvo' in d) || (d.alvo is string && d.alvo.size() <= 40))
          && (!('campo' in d) || (d.campo is string && d.campo.size() <= 60))
          && (!('de' in d) || (d.de is string && d.de.size() <= 2100))
          && (!('para' in d) || (d.para is string && d.para.size() <= 2100))
          && (!('porNome' in d) || (d.porNome is string && d.porNome.size() <= 100))
          && (!('porEmail' in d) || (d.porEmail is string && d.porEmail.size() <= 120));
      }

      // Mesma visibilidade das tarefas:
      //   . admin / ve-tudo -> toda a trilha
      //   . supervisor      -> a trilha do(s) departamento(s) dele
      //   . usuario comum   -> so a trilha das tarefas em que ele e o responsavel
      // A consulta do cliente precisa refletir isso (ver auditoria-tela.js).
      allow read:   if souDono()
        || (doDominio() && (
              veTudoCards()
              || supervisionaDepto(resource.data.departamento)
              || ('responsavelEmail' in resource.data
                  && resource.data.responsavelEmail == meuEmail())
           ));

      // create exige que porEmail seja o PROPRIO e-mail de quem grava (autoria
      // nao falsificavel) e valida tamanhos para barrar abuso de custo.
      allow create: if doDominio()
        && request.resource.data.porEmail == request.auth.token.email.lower()
        && auditoriaValida();

      allow update, delete: if false;
    }

    // ---------- Arquivo de tarefas (saem do quadro, ficam no relatorio) --------
    // cards_finalizados: concluidas (botao "Finalizar").
    // cards_cancelados : canceladas (antigo "Excluir").
    // Imutaveis depois de criadas; so admin apaga (limpeza). O create exige que
    // quem grava pudesse arquivar a tarefa (mesma regra de mexer nela).
    match /cards_finalizados/{id} {
      allow read:   if podeLerArquivo();
      allow create: if doDominio() && podeArquivar(request.resource.data);
      allow update: if false;
      allow delete: if souAdmin();
    }

    match /cards_cancelados/{id} {
      allow read:   if podeLerArquivo();
      allow create: if doDominio() && podeArquivar(request.resource.data);
      allow update: if false;
      allow delete: if souAdmin();
    }

    // Qualquer outra colecao continua bloqueada.
  }
}
